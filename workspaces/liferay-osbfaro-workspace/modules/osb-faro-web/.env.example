# Dev server upstream (e.g. https://analytics-stg.liferay.com)
FARO_URL=

# Authenticated session cookie copied from a logged-in browser (used by the
# dev-server proxy for SSO upstreams such as analytics-internal).
FARO_COOKIE=

# Optional: max agent turns per AI Chat question (default 20). The Anthropic
# API key, model, and Analytics Cloud auth are configured in the UI:
# Settings -> AI Assistant.
AC_CHAT_MAX_TURNS=
